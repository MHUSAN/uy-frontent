# Backend API base URL
# Leave empty or use /api for localhost:3001 in development to use `/api`, which Vite proxies to the local NestJS server
# Production Nginx setup also uses /api; separate API hosting needs its full HTTPS URL.
VITE_API_BASE_URL=/api

# Yandex Maps API key (optional, enables live maps)
VITE_YANDEX_MAPS_API_KEY=

# Development-only proxy destination: local backend or deployed HTTPS origin.
# Browser keeps VITE_API_BASE_URL=/api to use the same-origin proxy.
VITE_PROXY_TARGET=http://127.0.0.1:3000
