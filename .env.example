# Backend API base URL.
# Development: "/api" (Vite proxies it to VITE_PROXY_TARGET).
# Production static hosting: the full backend URL, e.g. https://real-estet-backend.onrender.com
VITE_API_BASE_URL=/api
# Development proxy target (no trailing slash).
VITE_PROXY_TARGET=http://127.0.0.1:3000
# Yandex Maps JavaScript API key (map is hidden without it; coordinates can still be typed).
VITE_YANDEX_MAPS_API_KEY=
